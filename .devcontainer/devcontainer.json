{
  "name": "image-search",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter",

        // Claude Code
        "anthropic.claude-code",

        // Docker
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",

        // 開発効率
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },

  "forwardPorts": [7860, 8080],
  "portsAttributes": {
    "7860": {
      "label": "Gradio UI",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "HTTP Server (embedding_map.html)"
    }
  },

  // KITTIデータセットとHuggingFaceモデルキャッシュをホストからマウント
  "mounts": [
    "source=/Users/otario/Data/kitti_dataset,target=/workspaces/image-search-project/kitti_dataset,type=bind,consistency=cached",
    "source=image-search-hf-cache,target=/home/vscode/.cache/huggingface,type=volume",
    "source=image-search-chroma,target=/workspaces/image-search-project/data/chroma_db,type=volume"
  ],

  "remoteUser": "vscode"
}
